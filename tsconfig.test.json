{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "lib": ["ES2022", "DOM"],
    "outDir": ".test-build",
    "rootDir": "src",
    "declaration": false,
    "sourceMap": false,
    "noEmitOnError": true,
    "skipLibCheck": true
  },
  "include": [
    "src/core/math.ts",
    "src/sensors/zoom.ts",
    "src/sensors/stability.ts",
    "src/vision/parallax.ts",
    "src/vision/frame-processing.ts",
    "src/vision/optical-flow.ts",
    "src/vision/frame-rate.ts",
    "src/vision/adaptive.ts",
    "src/vision/tracking.ts",
    "src/vision/integration.ts",
    "src/vision/histogram.ts",
    "src/vision/sharpness.ts",
    "src/vision/motion-ironbow.ts",
    "src/vision/observation.ts",
    "src/sensors/autostart.ts",
    "src/vision/baseline.ts",
    "src/vision/layers.ts",
    "src/terrain/tiles.ts",
    "src/terrain/render.ts",
    "src/vision/overlays.ts"
  ]
}
