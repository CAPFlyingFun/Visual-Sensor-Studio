{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "lib": ["ES2022", "DOM"],
    "outDir": ".test-build",
    "rootDir": "src",
    "declaration": false,
    "sourceMap": false,
    "noEmitOnError": true,
    "skipLibCheck": true
  },
  "include": [
    "src/core/math.ts",
    "src/sensors/zoom.ts",
    "src/vision/parallax.ts",
    "src/vision/frame-processing.ts",
    "src/vision/optical-flow.ts"
  ]
}
